[Unit]
Description=adblockerpro — network-wide DNS ad blocker
Documentation=https://github.com/ahardkore/adblockerpro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/adblockerpro --config /etc/adblockerpro/config.json
Restart=always
RestartSec=3
User=adblockerpro
Group=adblockerpro

# Binding port 53 as a non-root user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# The service only needs its own two directories.
StateDirectory=adblockerpro
ConfigurationDirectory=adblockerpro
ReadWritePaths=/var/lib/adblockerpro /etc/adblockerpro

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

# A Pi Zero has 512 MB; keep the resolver from ever taking the box down.
MemoryMax=512M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
